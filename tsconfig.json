{
  "compilerOptions": {
    "rootDirs": [
      "src",
      "tests"
    ],
    "outDir": "dist",
    "module": "commonjs",
    "target": "ES2023",
    "sourceMap": true,
    "esModuleInterop": true,
    "allowJs": true,
    "paths": {
      "@/tests/*": [
        "./tests/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "exclude": [],
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
